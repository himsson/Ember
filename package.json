{
  "name": "ember",
  "version": "0.1.0",
  "description": "Desktop agent app for local language models",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "bin": {
    "ember": "cli.js"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "dev": "node dev.js",
    "format": "prettier --write \"server/**/*.js\" \"ui/*.js\" \"ui/*.css\" \"scripts/*.js\" main.js preload.js cli.js dev.js",
    "build": "node scripts/fetch-voice.js && electron-builder --win",
    "icon": "node scripts/make-icon.js",
    "banner": "electron scripts/make-banner.js",
    "voice": "node scripts/fetch-voice.js"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "world-atlas": "^2.0.2"
  },
  "author": "himson",
  "build": {
    "appId": "app.ember.desktop",
    "productName": "Ember",
    "copyright": "Copyright (c) 2026 himson",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "cli.js",
      "server/**/*",
      "ui/**/*",
      "skills/**/*",
      "templates/**/*",
      "build/icon.*",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ember",
      "artifactName": "Ember-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/voice",
        "to": "voice",
        "filter": [
          "**/*",
          "!*.part",
          "!*.zip"
        ]
      }
    ]
  }
}
